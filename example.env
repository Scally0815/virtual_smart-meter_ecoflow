HTTP_PORT=80
DATA_PROVIDER=mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_STATE_TOPIC=virtual-smart-meter/og/measurement
MQTT_QOS=1
MQTT_RETAIN_EXPECTED=true
MDNS_ENABLED=true
# Optional advertised IPv4 address. Recommended for hosts with multiple interfaces.
# MDNS_ADDRESS=192.168.1.50
# Optional interface name (for example eth0) or its IPv4 address for multicast.
# MDNS_INTERFACE=eth0
DISCOVERY_REQUIRE_MEASUREMENT=true
DEBUG_ENDPOINT_ENABLED=true
